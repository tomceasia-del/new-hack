{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/factory.html", "destination": "/factory", "permanent": false },
    { "source": "/mall.html", "destination": "/mall", "permanent": false },
    { "source": "/moral.html", "destination": "/moral", "permanent": false },
    { "source": "/moral-drama.html", "destination": "/moral-drama", "permanent": false }
  ],
  "functions": {
    "api/gemini.js":             { "maxDuration": 60 },
    "api/gemini-verify.js":      { "maxDuration": 10 },
    "api/auth/login.js":         { "maxDuration": 10 },
    "api/auth/callback.js":      { "maxDuration": 15 },
    "api/auth/session.js":       { "maxDuration": 10 },
    "api/auth/logout.js":        { "maxDuration": 10 },
    "api/auth/clear.js":         { "maxDuration": 5 },
    "api/admin/admins.js":         { "maxDuration": 10 },
    "api/admin/access-requests.js": { "maxDuration": 10 },
    "api/tiktok-share-fetch.js":  { "maxDuration": 30 },
    "api/mall-mode.js":          { "maxDuration": 60 },
    "api/moral-drama-mode.js":   { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/start",  "destination": "/index.html" },
    { "source": "/",        "destination": "/login.html" },
    { "source": "/login",   "destination": "/login.html" },
    { "source": "/reset",   "destination": "/reset.html" },
    { "source": "/admin",   "destination": "/admin.html" },
    { "source": "/admin/approvals", "destination": "/admin-approvals.html" },
    { "source": "/cs",              "destination": "/story-config-mock.html" },
    { "source": "/mall",            "destination": "/story-config-mock.html" },
    { "source": "/mall/",           "destination": "/story-config-mock.html" },
    { "source": "/factory",         "destination": "/story-config-mock.html" },
    { "source": "/factory/",        "destination": "/story-config-mock.html" },
    { "source": "/moral",            "destination": "/story-config-mock.html" },
    { "source": "/moral/",           "destination": "/story-config-mock.html" },
    { "source": "/moral-drama",      "destination": "/story-config-mock.html" },
    { "source": "/moral-drama/",     "destination": "/story-config-mock.html" },
    { "source": "/story-config-mock", "destination": "/story-config-mock.html" },
    { "source": "/result",  "destination": "/story-config-result.html" },
    { "source": "/editor",  "destination": "/editor/index.html" },
    { "source": "/editor/", "destination": "/editor/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/editor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.+)\\.(js|css|svg|png|jpg|jpeg|gif|webp|woff2?)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/storymode-mock-gemini-core.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/storymode-mock-enrich-bundle.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/GEM_PACK_TIKTOK/factory-dna-prompt.snippet.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/build-info.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/reset.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/reset",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/story-config-mock.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/story-config-mock",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/story-config-result.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/cs",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/mall",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/mall/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/factory",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/factory/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/moral",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/moral/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/moral-drama",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/moral-drama/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/result",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}

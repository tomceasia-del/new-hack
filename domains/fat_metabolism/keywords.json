    {"pattern": "(?i)(เมตาโบ|metabolic|เผาผลาญ|BMR|RMR)", "case_insensitive": true, "description": "metabolism rate terminology"},
    {"pattern": "(?i)(autophagy|ออโตฟาจี|ซ่อมเซลล์|กินตัวเอง)", "case_insensitive": true, "description": "autophagy overlap"},

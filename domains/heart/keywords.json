  "regex_patterns": [
    {"pattern": "(?i)(หัวใจ|heart|cardiac|cardio)", "case_insensitive": true, "description": "Thai/English heart base terms"},
    {"pattern": "(?i)(หลอดเลือด|artery|arterial|vascular|vessel)", "case_insensitive": true, "description": "vessel/artery terminology"},
    {"pattern": "(?i)(คอเลสเตอรอล|cholesterol|LDL|HDL|ApoB|lipoprotein)", "case_insensitive": true, "description": "lipid panel terminology"},
    {"pattern": "(?i)(ไขมันเลว|ไขมันดี|bad\\s*cholesterol|good\\s*cholesterol)", "case_insensitive": true, "description": "lay cholesterol terminology"},
    {"pattern": "(?i)(atherosclerosis|อะเทอโรสเคลอโรซิส|หลอดเลือดแข็ง|plaque|คราบ)", "case_insensitive": true, "description": "atherosclerosis/plaque terminology"},
    {"pattern": "(?i)(หัวใจวาย|heart\\s*attack|myocardial\\s*infarction|MI|stroke|สโตรก|อัมพาต|อัมพฤกษ์)", "case_insensitive": true, "description": "acute CV events"},
    {"pattern": "(?i)(ความดัน|blood\\s*pressure|hypertension|BP|systolic|diastolic)", "case_insensitive": true, "description": "blood pressure terminology"},
    {"pattern": "(?i)(statin|สแตติน|atorvastatin|rosuvastatin|simvastatin|lovastatin)", "case_insensitive": true, "description": "statin generics and class"},
    {"pattern": "(?i)(warfarin|วอร์ฟาริน|coumadin|anticoagulant|ยาละลายลิ่มเลือด|blood\\s*thinner|DOAC|rivaroxaban|apixaban|dabigatran)", "case_insensitive": true, "description": "anticoagulant flag — CRITICAL for safety validator"},
    {"pattern": "(?i)(aspirin|แอสไพริน|clopidogrel|antiplatelet|ยาต้านเกล็ดเลือด)", "case_insensitive": true, "description": "antiplatelet flag — CRITICAL for safety"},
    {"pattern": "(?i)(omega\\s*-?\\s*3|โอเมก้า\\s*3|EPA|DHA|icosapent|fish\\s*oil|น้ำมันปลา)", "case_insensitive": true, "description": "omega-3/EPA terminology"},
    {"pattern": "(?i)(CoQ10|co-?q10|coenzyme\\s*q10|ubiquinol|ubiquinone|โคคิวเทน|โคเอนไซม์)", "case_insensitive": true, "description": "CoQ10 terminology"},
    {"pattern": "(?i)(nattokinase|แนทโตไคเนส|natto)", "case_insensitive": true, "description": "nattokinase terminology"},
    {"pattern": "(?i)(bergamot|เบอร์กาม็อต|BPF)", "case_insensitive": true, "description": "bergamot terminology"},
    {"pattern": "(?i)(vitamin\\s*k2|K2|MK-?7|menaquinone|วิตามิน\\s*เค\\s*2)", "case_insensitive": true, "description": "vitamin K2 terminology"},
    {"pattern": "(?i)(niacin|nicotinic\\s*acid|ไนอาซิน|B3)", "case_insensitive": true, "description": "niacin terminology"},
    {"pattern": "(?i)(red\\s*yeast\\s*rice|ข้าวยีสต์แดง|monacolin)", "case_insensitive": true, "description": "red yeast rice terminology — duplicate-statin safety flag"},
    {"pattern": "(?i)(berberine|เบอร์เบอรีน)", "case_insensitive": true, "description": "berberine terminology"},
    {"pattern": "(?i)(citrulline|arginine|ซิทรูลลีน|อาร์จินีน)", "case_insensitive": true, "description": "NO-precursor terminology"},
    {"pattern": "(?i)(garlic|กระเทียม|aged\\s*garlic|AGE)", "case_insensitive": true, "description": "garlic extract terminology"},
    {"pattern": "(?i)(CAC|calcium\\s*score|coronary\\s*calcium|Agatston|หินปูนหลอดเลือด|แคลเซียมสกอร์)", "case_insensitive": true, "description": "CAC scoring terminology"},
    {"pattern": "(?i)(Lp\\(a\\)|lipoprotein\\s*a|ไลโปโปรตีน\\s*เอ)", "case_insensitive": true, "description": "Lp(a) terminology"},
    {"pattern": "(?i)(nitric\\s*oxide|NO\\b|eNOS|ไนตริก\\s*ออกไซด์)", "case_insensitive": true, "description": "NO pathway"},
    {"pattern": "(?i)(shear\\s*stress|endothelial\\s*dysfunction|flow-?mediated|FMD|เอนโดทีเลียล)", "case_insensitive": true, "description": "endothelial function"},
    {"pattern": "(?i)(zone\\s*2|โซน\\s*2|zone2|aerobic\\s*base|VO2\\s*max)", "case_insensitive": true, "description": "zone 2 / cardio training"},
    {"pattern": "(?i)(REDUCE-?IT|JUPITER|CANTOS|INTERHEART|MESA|HORIZON)", "case_insensitive": true, "description": "landmark trial names"},
    {"pattern": "(?i)(\\d+)\\s*(mg|mmol|mmHg)\\b", "case_insensitive": true, "description": "numeric clinical values with units (mg/dL, mmHg)"}

  "regex_patterns": [
    {"pattern": "(?i)(วิตามิน|vitamin)\\s*[A-Ka-k0-9]+", "case_insensitive": true, "description": "vitamin A/B/C/D/E/K + number (e.g. vitamin D3, B12, K2)"},
    {"pattern": "(?i)(แมกนีเซียม|magnesium)\\s*(glycinate|oxide|citrate|threonate|malate|chloride|ไกลซิเนต|ออกไซด์|ซิเตรต|ทรีโอเนต)?", "case_insensitive": true, "description": "Mg + form variants"},
    {"pattern": "(?i)(สังกะสี|zinc|Zn)\\s*(picolinate|gluconate|citrate|oxide|พิโคลิเนต|กลูโคเนต|ออกไซด์)?", "case_insensitive": true, "description": "Zn + form variants"},
    {"pattern": "(?i)(omega[- ]?3|โอเมก้า[-\\s]?3|fish\\s*oil|น้ำมันปลา)", "case_insensitive": true, "description": "omega-3 / fish oil mentions"},
    {"pattern": "(?i)(EPA|DHA|ALA)", "case_insensitive": true, "description": "omega-3 fatty acid subtypes"},
    {"pattern": "(?i)(MK[-\\s]?7|MK[-\\s]?4|menaquinone|วิตามินเค2|K2)", "case_insensitive": true, "description": "vitamin K2 / MK forms"},
    {"pattern": "(?i)(B12|B\\s*12|cobalamin|โคบาลามิน|methyl[- ]?B|methylcobalamin|cyanocobalamin)", "case_insensitive": true, "description": "B12 / cobalamin forms"},
    {"pattern": "(?i)(MTHFR|5[-\\s]?MTHF|folate|โฟเลต|folic\\s*acid|กรดโฟลิก)", "case_insensitive": true, "description": "folate / MTHFR"},
    {"pattern": "(?i)(25[-\\s]?OH[-\\s]?D|25\\(OH\\)D|25[-\\s]?hydroxyvitamin|hydroxy\\s*D)", "case_insensitive": true, "description": "vitamin D blood marker"},
    {"pattern": "(?i)(RDA|AI|UL|EAR|DV|recommended\\s*daily|ค่าแนะนำ|ปริมาณที่แนะนำ)", "case_insensitive": true, "description": "dietary reference intake terms"},
    {"pattern": "(?i)(bioavailability|ดูดซึม|การดูดซึม|ชีวปริมาณ)", "case_insensitive": true, "description": "bioavailability terminology"},
    {"pattern": "(?i)(chelate|คีเลต|bisglycinate|glycinate|picolinate|gluconate|citrate|oxide|sulfate|ethyl\\s*ester|triglyceride)", "case_insensitive": true, "description": "mineral/fat form descriptors (form comparisons are core of supplements ads)"},
    {"pattern": "(?i)(liposomal|ลิโพโซมอล|liposome)", "case_insensitive": true, "description": "liposomal delivery"},
    {"pattern": "(?i)(multivitamin|มัลติวิตามิน|วิตามินรวม)", "case_insensitive": true, "description": "multivitamin"},
    {"pattern": "(?i)(\\d+)\\s*(IU|µg|ug|mcg|mg|g|ไมโครกรัม|มิลลิกรัม)", "case_insensitive": true, "description": "dose number+unit (RDA/UL/serving)"},
    {"pattern": "(?i)(deficiency|ขาด(วิตามิน|แร่ธาตุ|สังกะสี|แมกนีเซียม|เหล็ก))", "case_insensitive": true, "description": "deficiency mentions"},
    {"pattern": "(?i)(อย\\.|อย\\s|FDA\\s*ไทย|Thai\\s*FDA)", "case_insensitive": true, "description": "Thai FDA references (relevant for regulatory claim boundary)"}
  ]
}

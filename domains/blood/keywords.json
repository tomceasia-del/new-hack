  "regex_patterns": [
    {"pattern": "(?i)ความดัน(โลหิต|สูง|ต่ำ)?", "case_insensitive": true, "description": "Thai blood-pressure phrasings"},
    {"pattern": "(?i)(blood\\s*pressure|BP|hypertension|systolic|diastolic|mmHg)", "case_insensitive": true, "description": "English BP terms"},
    {"pattern": "(?i)(คอเลสเตอรอล|ไขมันในเลือด|ไขมันเลว|ไขมันดี|ไตรกลีเซอไรด์)", "case_insensitive": true, "description": "Thai lipid-panel terms"},
    {"pattern": "(?i)\\b(LDL|HDL|TG|non[-\\s]?HDL|ApoB|Apo\\s?B|Lp\\(a\\))\\b", "case_insensitive": true, "description": "Lipid panel markers"},
    {"pattern": "(?i)(nitric\\s*oxide|ไนตริก\\s*ออกไซด์|\\bNO\\b|eNOS)", "case_insensitive": true, "description": "Nitric oxide mentions"},
    {"pattern": "(?i)(L[-\\s]?arginine|L[-\\s]?citrulline|อาร์จินีน|ซิทรูลีน)", "case_insensitive": true, "description": "NO precursor amino acids"},
    {"pattern": "(?i)(beetroot|บีทรูท|บีท|ผักใบเขียว|ผักโขม|ผักกาด|rocket|arugula|rucola)", "case_insensitive": true, "description": "Nitrate-rich foods"},
    {"pattern": "(?i)(ferritin|เฟอร์ริติน|โลหิตจาง|เลือดจาง|ซีด|ขาดเหล็ก|iron\\s*deficien)", "case_insensitive": true, "description": "Iron status terms"},
    {"pattern": "(?i)(hemochromatosis|เหล็กเกิน|iron\\s*overload|HFE|C282Y)", "case_insensitive": true, "description": "Iron overload terms"},
    {"pattern": "(?i)(homocysteine|โฮโมซิสเทอีน|MTHFR|methylfolate|5-?MTHF|B12|folate)", "case_insensitive": true, "description": "Homocysteine/methylation"},
    {"pattern": "(?i)(endothelial|endothelium|เอนโดทีเลียม|FMD|flow[-\\s]?mediated)", "case_insensitive": true, "description": "Endothelial function"},
    {"pattern": "(?i)(\\d{2,3})\\s*(/|\\s)\\s*(\\d{2,3})\\s*mm\\s*hg", "case_insensitive": true, "description": "BP number pattern e.g. 140/90 mmHg"},
    {"pattern": "(?i)(เส้นเลือด|หลอดเลือด)(ตีบ|แข็ง|ฝอย|อุดตัน|โป่ง)?", "case_insensitive": true, "description": "Vessel-state compounds"},
    {"pattern": "(?i)(niacin|ไนอะซิน|vitamin\\s*B3|nicotinic\\s*acid)", "case_insensitive": true, "description": "Niacin"},
    {"pattern": "(?i)(CoQ10|Q10|ubiquinol|ubiquinone|โคคิวเท็น)", "case_insensitive": true, "description": "CoQ10"},
    {"pattern": "(?i)(vitamin\\s*K2|MK-?7|vit\\s*K2|K2)", "case_insensitive": true, "description": "Vitamin K2"},
    {"pattern": "(?i)(pycnogenol|maritime\\s*pine|ไพคโนจินอล)", "case_insensitive": true, "description": "Pycnogenol"},
    {"pattern": "(?i)(dark\\s*chocolate|cocoa|flavanol|ช็อกโกแลตดำ|โกโก้)", "case_insensitive": true, "description": "Cocoa flavanols"}
  ]
